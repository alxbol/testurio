# Smoke-test targets & credentials. Copy to .env and fill with real values.
# .env is git-ignored; this template is committed.

# MT Test emulator host (MT4 :5000 / MT5 :5001 share this host)
MT_HOST=

# ClickHouse (collector.order / collector.execution)
CH_URL=http://clickhouse.example:8123
CH_USER=
CH_PASS=

# Kafka brokers (local port-forward addresses; see tests/smoke/scripts/)
KAFKA_BROKERS=127.0.0.1:9092,127.0.0.2:9092,127.0.0.3:9092
